GROQ_API_KEY=
GEMINI_API_KEY=
# Leave empty unless you need a proxy or test endpoint.
GROQ_BASE_URL=
GEMINI_BASE_URL=
# Example: ATLAS_WORKSPACE=D:\Atlas\workspace
ATLAS_WORKSPACE=
# Required. groq, gemini, or a fallback chain like groq,gemini. scripted is for tests only.
ATLAS_LLM_PROVIDER=groq,gemini
# Set to 1 to log per-step metadata (provider, model, tool names; never content or keys).
ATLAS_LLM_DEBUG=
# Toolsets enabled from the first step of every run (comma-separated, e.g. fs,docx).
# Empty = lazy: the model enables toolsets itself with tools.enable. Unknown names fail at startup.
ATLAS_ALWAYS_ON_TOOLSETS=
# free-tier model ids change; check the provider's current model list
GROQ_MODEL=openai/gpt-oss-20b
# free-tier model ids change; check the provider's current model list
GEMINI_MODEL=gemini-3.1-flash-lite
ATLAS_LLM_TIMEOUT_S=30
ATLAS_LLM_TEMPERATURE=0.2
ATLAS_LLM_MAX_TOKENS=1024
# https URL of your LMS site root, for example https://lms.example.edu
LMS_BASE_URL=
# Browser profile folder; must be inside the repo data/ folder. Empty = data/browser-profile
ATLAS_BROWSER_PROFILE=
# true/false: run lms.scan without a visible window (lms.login is always visible)
LMS_HEADLESS=
