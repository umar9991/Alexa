GROQ_API_KEY=
GEMINI_API_KEY=
# Leave empty unless you need a proxy or test endpoint.
GROQ_BASE_URL=
GEMINI_BASE_URL=
# Example: ATLAS_WORKSPACE=D:\Atlas\workspace
ATLAS_WORKSPACE=
ATLAS_LLM_PROVIDER=scripted
# free-tier model ids change; check the provider's current model list
GROQ_MODEL=openai/gpt-oss-20b
# free-tier model ids change; check the provider's current model list
GEMINI_MODEL=gemini-3.1-flash-lite
ATLAS_LLM_TIMEOUT_S=30
ATLAS_LLM_TEMPERATURE=0.2
ATLAS_LLM_MAX_TOKENS=1024
